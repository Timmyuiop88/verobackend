NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres + Redis (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tradevero?schema=public
REDIS_URL=redis://localhost:6379

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Comma-separated list of frontend origins allowed to use tokens against this API
# (Clerk's `azp` check). Add every deployed frontend origin — production, staging,
# AND localhost for local dev against a hosted backend.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,https://tradevero.vercel.app

# Paystack (fiat deposits)
# Wallet credits are always USD. Charge currency is usually NGN for NG merchants.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx
PAYSTACK_CURRENCY=NGN
PAYSTACK_USD_NGN_RATE=1600

# OxaPay (crypto deposits)
OXAPAY_MERCHANT_API_KEY=xxx
OXAPAY_WEBHOOK_SECRET=xxx

# eSIM Access (HMAC: sign with ESIM_SECRET_KEY, send ESIM_ACCESS_CODE in header)
ESIM_ACCESS_CODE=your_access_code
ESIM_SECRET_KEY=your_secret_key
ESIM_BASE_URL=https://api.esimaccess.com
ESIM_ACCESS_WEBHOOK_SECRET=

# Reloadly (gift cards). Leave the credentials blank to run without gift cards —
# the app boots fine and the endpoints report "not configured".
# Set your Reloadly account currency to USD so product costs arrive in the same
# currency as the wallet and no FX conversion is applied per sale.
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
# sandbox spends test balance against giftcards-sandbox.reloadly.com
RELOADLY_ENV=sandbox
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
# Shown to the recipient as the sender of the card
RELOADLY_SENDER_NAME=TradeVero
# Reloadly is prepaid — ops alert fires below this balance
RELOADLY_MIN_BALANCE_ALERT=50
# Webhook signing secret from Dashboard → Developers → Webhooks
# (NOT the same as RELOADLY_CLIENT_SECRET). Required in production.
RELOADLY_WEBHOOK_SECRET=

# AES-256-GCM key for gift card numbers/PINs at rest — `openssl rand -hex 32`.
# Rotating this makes already-issued card codes undecryptable.
GIFTCARD_ENCRYPTION_KEY=
# Nightly catalog refresh. Off by default; POST /admin/giftcards/sync always works.
GIFTCARD_SYNC_CRON_ENABLED=false
GIFTCARD_SYNC_CRON=0 3 * * *
GIFTCARD_SYNC_PAGE_SIZE=200
# Parallel product pages in flight — keep low, Reloadly rate-limits hard
GIFTCARD_SYNC_CONCURRENCY=3
# Safety valve: skip the stale sweep if it would archive more than this share
# of the catalog, so a provider outage can't empty the storefront
GIFTCARD_ARCHIVE_SWEEP_MAX_PERCENT=10

# Email (plain SMTP — swap providers by just changing these, no code changes).
# Resend: host=smtp.resend.com, port=587, secure=false, user="resend", pass=<Resend API key>.
# Also works unchanged with Gmail, SES, Mailgun, Postmark, etc.
EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxx
SMTP_FROM_EMAIL=no-reply@tradevero.app
SMTP_FROM_NAME=TradeVero
