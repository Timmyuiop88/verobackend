NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Postgres + Redis (required)
DATABASE_URL=postgresql://user:password@localhost:5432/tradevero?schema=public
REDIS_URL=redis://localhost:6379

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Comma-separated list of frontend origins allowed to use tokens against this API
# (Clerk's `azp` check). Add every deployed frontend origin — production, staging,
# AND localhost for local dev against a hosted backend.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://localhost:3001,https://tradevero.vercel.app

# Paystack (fiat deposits)
# Wallet credits are always USD. Charge currency is usually NGN for NG merchants.
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=sk_test_xxx
PAYSTACK_CURRENCY=NGN
PAYSTACK_USD_NGN_RATE=1600

# OxaPay (crypto deposits)
OXAPAY_MERCHANT_API_KEY=xxx
OXAPAY_WEBHOOK_SECRET=xxx

# eSIM Access (HMAC: sign with ESIM_SECRET_KEY, send ESIM_ACCESS_CODE in header)
ESIM_ACCESS_CODE=your_access_code
ESIM_SECRET_KEY=your_secret_key
ESIM_BASE_URL=https://api.esimaccess.com
ESIM_ACCESS_WEBHOOK_SECRET=

# Email (plain SMTP — swap providers by just changing these, no code changes).
# Resend: host=smtp.resend.com, port=587, secure=false, user="resend", pass=<Resend API key>.
# Also works unchanged with Gmail, SES, Mailgun, Postmark, etc.
EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=re_xxx
SMTP_FROM_EMAIL=no-reply@tradevero.app
SMTP_FROM_NAME=TradeVero
