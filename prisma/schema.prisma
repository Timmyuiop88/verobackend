generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentProvider {
  PAYSTACK
  OXAPAY
}

enum PaymentIntentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum PricingProfileName {
  STANDARD
  COMPETITIVE
  PREMIUM
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderType {
  /// Creates a brand-new eSIM (ProviderOrder).
  PURCHASE
  /// Adds data/validity to an existing eSIM (targetProviderOrderId).
  TOPUP
  /// Buys a gift card denomination from Reloadly (GiftCardIssuance).
  GIFT_CARD
  /// One-time SMS verification number from SMSPool (SmsVerification).
  SMS_ONE_TIME
  /// Multi-day rented number from SMSPool (NumberRental).
  NUMBER_RENTAL
  /// Extends an existing NumberRental by N days.
  NUMBER_RENTAL_EXTEND
}

enum ProviderName {
  ESIM_ACCESS
  RELOADLY
  SMSPOOL
}

enum NotificationType {
  WALLET_DEPOSIT
  WALLET_REFUND
  WALLET_ADJUSTMENT
  ORDER_COMPLETED
  ORDER_FAILED
  TOPUP_COMPLETED
  TOPUP_FAILED
  GENERIC
  GIFT_CARD_READY
  GIFT_CARD_FAILED
  SMS_CODE_RECEIVED
  SMS_ORDER_FAILED
  RENTAL_READY
  RENTAL_SMS_RECEIVED
  RENTAL_EXPIRED
  RENTAL_FAILED
}

enum SmsPricingScope {
  GLOBAL
  COUNTRY
  SERVICE
  RENTAL_SKU
}

enum SmsVerificationStatus {
  PENDING
  AWAITING_SMS
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
  FAILED
}

enum NumberRentalStatus {
  PENDING
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  REFUNDED
  FAILED
}

enum SmsSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum GiftCardDenominationType {
  /// Customer buys one of `fixedRecipientDenominations`.
  FIXED
  /// Customer picks any amount between min/max — priced live, phase 3.
  RANGE
}

/// Resolution order when pricing a denomination: the most specific active
/// rule wins (PRODUCT beats BRAND beats CATEGORY beats COUNTRY beats GLOBAL).
enum GiftCardPricingScope {
  GLOBAL
  COUNTRY
  CATEGORY
  BRAND
  PRODUCT
}

/// Mirrors Reloadly's transaction statuses. Note the difference between
/// REFUNDED (Reloadly already reversed their charge) and FAILED (they have
/// not) — the latter needs manual reconciliation against their balance.
enum GiftCardIssuanceStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum GiftCardSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  clerkId   String   @unique
  email     String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet         Wallet?
  profile        UserProfile?
  paymentIntents PaymentIntent[]
  orders         Order[]
  notifications  Notification[]

  @@map("users")
}

/// In-app (not push) notification feed — "events" like deposits, order
/// completion/failure, and top-ups surface here. Each notification also
/// fans out to an email via the same event, independently of this row.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  message   String
  /// Structured extra context for deep-linking (e.g. { "orderId": "..." }).
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Custom profile data owned entirely by TradeVero — deliberately kept out of
/// Clerk metadata so it stays put (and queryable/joinable) if we ever swap
/// auth providers. Clerk continues to own identity (email, login) only.
model UserProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  displayName String?
  phone       String?
  country     String?
  avatarUrl   String?
  dateOfBirth DateTime?
  /// Structured, known-shape settings (notifications, language, currency display, etc.)
  preferences Json?
  /// Open-ended bucket for future fields that don't warrant a migration yet.
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(18, 4)
  currency  String   @default("USD")
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String                  @id @default(uuid()) @db.Uuid
  walletId     String                  @db.Uuid
  type         WalletTransactionType
  amount       Decimal                 @db.Decimal(18, 4)
  balanceAfter Decimal                 @db.Decimal(18, 4)
  reference    String                  @unique
  status       WalletTransactionStatus @default(COMPLETED)
  metadata     Json?
  createdAt    DateTime                @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model PaymentIntent {
  id         String              @id @default(uuid()) @db.Uuid
  userId     String              @db.Uuid
  provider   PaymentProvider
  externalId String?
  amount     Decimal             @db.Decimal(18, 4)
  currency   String              @default("USD")
  status     PaymentIntentStatus @default(PENDING)
  metadata   Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([userId])
  @@map("payment_intents")
}

model PricingProfile {
  id        String             @id @default(uuid()) @db.Uuid
  name      PricingProfileName @unique
  /// Markup rule: { "type": "percent" | "fixed", "value": number }
  rules     Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  products      Product[]
  topUpProducts TopUpProduct[]

  @@map("pricing_profiles")
}

/// Supported countries/regions from eSIM Access POST /location/list
model Region {
  id           String   @id @default(uuid()) @db.Uuid
  /// ISO / provider location code (e.g. US, JP, or regional code)
  code         String   @unique
  /// Display name (e.g. United States, Europe)
  name         String
  /// 1 = single country, 2 = multi-country region
  type         Int
  /// For type=2: [{ "code": "ES", "name": "Spain" }, ...]
  subLocations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@map("regions")
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  supplierSku      String
  name             String
  locationCode     String?
  dataVolumeBytes  BigInt?
  durationDays     Int?
  costPrice        Decimal       @db.Decimal(18, 4)
  retailPrice      Decimal       @db.Decimal(18, 4)
  currency         String        @default("USD")
  status           ProductStatus @default(DRAFT)
  pricingProfileId String?       @db.Uuid
  manualOverride   Boolean       @default(false)
  /// Admin-controlled kill switch — off by default. Even if TopUpProduct rows
  /// exist and are PUBLISHED, GET /esims/:id/topup-packages returns nothing
  /// for eSIMs sold under this product while this is false.
  topUpEnabled     Boolean       @default(false)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pricingProfile PricingProfile? @relation(fields: [pricingProfileId], references: [id])
  orders         Order[]
  topUpProducts  TopUpProduct[]

  @@unique([supplierSku])
  @@index([status, locationCode])
  @@map("products")
}

/// A top-up tier for a specific base Product, admin-curated the same way as
/// the base catalog: synced from eSIM Access `/package/list` (queried by
/// `packageCode`, no iccid/eSIM instance required), reviewed, priced, and
/// published before customers can buy it. Charging still re-validates
/// eligibility live per-eSIM right before the provider call — this table only
/// controls *what's offered and at what price*, not final eligibility.
model TopUpProduct {
  id               String        @id @default(uuid()) @db.Uuid
  productId        String        @db.Uuid
  /// Provider's TOPUP_-prefixed package code, passed to /esim/topup.
  packageCode      String
  name             String
  dataVolumeBytes  BigInt?
  durationDays     Int?
  costPrice        Decimal       @db.Decimal(18, 4)
  retailPrice      Decimal       @db.Decimal(18, 4)
  currency         String        @default("USD")
  status           ProductStatus @default(DRAFT)
  pricingProfileId String?       @db.Uuid
  manualOverride   Boolean       @default(false)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  pricingProfile PricingProfile? @relation(fields: [pricingProfileId], references: [id])
  orders         Order[]

  @@unique([productId, packageCode])
  @@index([productId, status])
  @@map("topup_products")
}

model Order {
  id                     String      @id @default(uuid()) @db.Uuid
  userId                 String      @db.Uuid
  orderType              OrderType   @default(PURCHASE)
  /// Required for PURCHASE, unused (null) for TOPUP — top-up packages aren't
  /// synced catalog items, their price is computed live at request time.
  productId              String?     @db.Uuid
  amount                 Decimal     @db.Decimal(18, 4)
  currency               String      @default("USD")
  status                 OrderStatus @default(PAID)
  /// Machine-readable reason set when status transitions to FAILED/REFUNDED (e.g. "provider_rejected:200007:...")
  failureReason          String?
  /// Set only for TOPUP orders — the existing eSIM (ProviderOrder) being topped up.
  targetProviderOrderId  String?     @db.Uuid
  /// Set only for TOPUP orders — which curated TopUpProduct SKU was charged, for auditing/reporting.
  topUpProductId         String?     @db.Uuid
  /// Set only for GIFT_CARD orders — the exact denomination SKU that was sold.
  giftCardDenominationId String?     @db.Uuid
  /// Set only for SMS_ONE_TIME orders.
  smsOneTimeOfferId      String?     @db.Uuid
  /// Set for NUMBER_RENTAL (and optionally NUMBER_RENTAL_EXTEND) orders.
  numberRentalPlanId     String?     @db.Uuid
  /// Set only for NUMBER_RENTAL_EXTEND — the rental being extended.
  targetNumberRentalId   String?     @db.Uuid
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product             Product?       @relation(fields: [productId], references: [id])
  topUpProduct        TopUpProduct?  @relation(fields: [topUpProductId], references: [id])
  providerOrder       ProviderOrder? @relation("PurchaseOrder")
  targetProviderOrder ProviderOrder? @relation("TopUps", fields: [targetProviderOrderId], references: [id])

  giftCardDenomination GiftCardDenomination? @relation(fields: [giftCardDenominationId], references: [id])
  giftCardIssuance     GiftCardIssuance?

  smsOneTimeOffer    SmsOneTimeOffer? @relation(fields: [smsOneTimeOfferId], references: [id])
  smsVerification    SmsVerification?
  numberRentalPlan   SmsRentalPlan?   @relation(fields: [numberRentalPlanId], references: [id])
  numberRental       NumberRental?    @relation("RentalPurchase")
  targetNumberRental NumberRental?    @relation("RentalExtends", fields: [targetNumberRentalId], references: [id])

  @@index([userId, createdAt])
  /// Powers the stuck-order reconciliation sweep (find orders wedged in FULFILLING).
  @@index([status, updatedAt])
  /// Powers top-up history lookups and the "is a top-up already in flight
  /// for this eSIM" concurrency guard.
  @@index([targetProviderOrderId, status])
  @@index([targetNumberRentalId, status])
  @@map("orders")
}

model ProviderOrder {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @unique @db.Uuid
  provider         ProviderName @default(ESIM_ACCESS)
  externalOrderId  String?
  esimTranNo       String?
  iccid            String?
  lpaCode          String?
  qrCodeUrl        String?
  /// Direct-download link for the QR image (fallback when no camera / for sharing).
  shortUrl         String?
  /// Manual APN fallback (rarely needed — most devices auto-configure from the eSIM profile).
  apn              String?
  pin              String?
  puk              String?
  /// Set once the provider reports the eSIM has been installed on a device.
  activatedAt      DateTime?
  /// Cached from the package list (type=TOPUP + iccid lookup). 0/absent = not
  /// top-uppable; refreshed opportunistically, not authoritative for charging
  /// — always re-verify live against the provider before accepting a top-up.
  supportTopUpType Int?
  status           String?
  rawResponse      Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order  Order      @relation("PurchaseOrder", fields: [orderId], references: [id], onDelete: Cascade)
  usage  EsimUsage?
  /// All TOPUP orders that targeted this eSIM — the top-up history, with no
  /// separate ledger table needed.
  topUps Order[]    @relation("TopUps")

  @@index([externalOrderId])
  @@map("provider_orders")
}

model EsimUsage {
  id              String    @id @default(uuid()) @db.Uuid
  providerOrderId String    @unique @db.Uuid
  dataUsedBytes   BigInt    @default(0)
  dataTotalBytes  BigInt?
  expiresAt       DateTime?
  lastSyncedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  providerOrder ProviderOrder @relation(fields: [providerOrderId], references: [id], onDelete: Cascade)

  @@map("esim_usages")
}

/// Countries supported for gift cards, from Reloadly `GET /countries`.
/// Deliberately separate from `Region` (the eSIM location table) — the two
/// providers have unrelated code sets and Region's type/subLocations
/// semantics don't apply here.
model GiftCardCountry {
  id             String   @id @default(uuid()) @db.Uuid
  /// Reloadly `isoName`, e.g. US
  code           String   @unique
  name           String
  continent      String?
  currencyCode   String?
  currencyName   String?
  currencySymbol String?
  flagUrl        String?
  /// ["+1", ...]
  callingCodes   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@map("gift_card_countries")
}

/// Reloadly `GET /product-categories`, plus TradeVero-owned merchandising fields.
model GiftCardCategory {
  id           String   @id @default(uuid()) @db.Uuid
  externalId   Int      @unique
  name         String
  slug         String   @unique
  displayOrder Int      @default(0)
  featured     Boolean  @default(false)
  iconUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products GiftCardProduct[]

  @@map("gift_card_categories")
}

/// Derived from the `brand` object embedded in each product. Groups the
/// per-country variants of one brand (Amazon US / Amazon UK / Amazon DE).
model GiftCardBrand {
  id         String   @id @default(uuid()) @db.Uuid
  externalId Int      @unique
  name       String
  slug       String   @unique
  logoUrl    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  products GiftCardProduct[]

  @@index([name])
  @@map("gift_card_brands")
}

/// A Reloadly gift card product — the *parent* of one or more buyable
/// denominations, not a SKU itself. Customers always order a
/// GiftCardDenomination; this row holds the brand/country/redeem metadata
/// and the provider economics shared across its denominations.
model GiftCardProduct {
  id                String                   @id @default(uuid()) @db.Uuid
  externalProductId Int                      @unique
  name              String
  slug              String                   @unique
  brandId           String?                  @db.Uuid
  categoryId        String?                  @db.Uuid
  /// ISO code matching GiftCardCountry.code. Not an FK — Reloadly occasionally
  /// returns product countries absent from /countries, and a missing country
  /// row shouldn't fail the whole sync.
  countryCode       String?
  /// Redeemable in any country rather than tied to `countryCode`.
  global            Boolean                  @default(false)
  /// TradeVero curation state — DRAFT until an admin publishes.
  status            ProductStatus            @default(DRAFT)
  /// Reloadly's own ACTIVE/INACTIVE flag, kept separate from our `status`.
  providerStatus    String?
  denominationType  GiftCardDenominationType @default(FIXED)

  /// Currency the card is denominated in (what the recipient sees).
  recipientCurrencyCode String  @default("USD")
  /// Currency Reloadly charges our prepaid balance in (our account currency).
  senderCurrencyCode    String  @default("USD")
  /// recipientCurrencyToSenderCurrencyExchangeRate at last sync.
  exchangeRate          Decimal @default(1) @db.Decimal(18, 8)

  /// Reloadly's per-transaction fee, as a percentage of the sender amount.
  senderFeePercentage Decimal @default(0) @db.Decimal(9, 4)
  /// Flat component of the fee, when the provider quotes one.
  senderFeeFixed      Decimal @default(0) @db.Decimal(18, 4)
  /// Our commission — deducted from the charge at purchase. This is the
  /// primary source of gift card margin.
  discountPercentage  Decimal @default(0) @db.Decimal(9, 4)

  supportsPreOrder Boolean @default(false)
  /// additionalRequirements.userIdRequired — needs a game/user ID at checkout.
  userIdRequired   Boolean @default(false)
  logoUrls         Json?

  redeemInstructionConcise String?
  redeemInstructionVerbose String?

  /// RANGE products only — customer-chosen amount bounds (phase 3).
  minRecipientDenomination Decimal? @db.Decimal(18, 4)
  maxRecipientDenomination Decimal? @db.Decimal(18, 4)
  minSenderDenomination    Decimal? @db.Decimal(18, 4)
  maxSenderDenomination    Decimal? @db.Decimal(18, 4)

  /// Optional per-product pricing override; otherwise resolved by scope chain.
  pricingRuleId String? @db.Uuid

  /// Stamped with the sync run's start time on every run that sees this
  /// product. Rows left behind are what the stale sweep archives.
  lastSeenAt DateTime @default(now())
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  brand         GiftCardBrand?         @relation(fields: [brandId], references: [id])
  category      GiftCardCategory?      @relation(fields: [categoryId], references: [id])
  pricingRule   GiftCardPricingRule?   @relation(fields: [pricingRuleId], references: [id])
  denominations GiftCardDenomination[]

  @@index([status, countryCode])
  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([lastSeenAt])
  @@index([name])
  @@map("gift_card_products")
}

/// The actual buyable SKU. One row per face value offered by the parent
/// product, each priced and published independently — a $5 tier can be
/// unprofitable and stay hidden while the $50 tier of the same product sells.
model GiftCardDenomination {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  /// Face value in the product's recipient currency — what the card is worth.
  faceValue      Decimal @db.Decimal(18, 4)
  /// What Reloadly charges us before fee/discount (fixedRecipientToSenderDenominationsMap).
  senderCost     Decimal @db.Decimal(18, 4)
  feeAmount      Decimal @default(0) @db.Decimal(18, 4)
  /// Commission credited back by Reloadly on this denomination.
  discountAmount Decimal @default(0) @db.Decimal(18, 4)
  /// senderCost + feeAmount - discountAmount. The number retail must beat.
  netCost        Decimal @db.Decimal(18, 4)
  retailPrice    Decimal @db.Decimal(18, 4)
  currency       String  @default("USD")

  status         ProductStatus @default(DRAFT)
  /// Retail price was set by hand — sync recalculation skips this row.
  manualOverride Boolean       @default(false)
  /// False when no price clears the margin floor without breaching the
  /// over-face ceiling. Such rows are never auto-published.
  viable         Boolean       @default(true)
  viabilityNote  String?
  sortOrder      Int           @default(0)
  lastSeenAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product GiftCardProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([productId, faceValue])
  @@index([productId, status])
  @@index([status, viable])
  @@map("gift_card_denominations")
}

/// Gift card margin rules. Separate from PricingProfile (which is a flat
/// cost markup for eSIM) because gift cards are priced against face value:
/// retail = max(netCost × (1 + minMargin), face × (1 - customerDiscount)),
/// rejected entirely if that exceeds face × (1 + maxOverFace).
model GiftCardPricingRule {
  id       String               @id @default(uuid()) @db.Uuid
  scope    GiftCardPricingScope
  /// Category/brand/product uuid, or ISO country code. "*" for GLOBAL —
  /// a sentinel rather than null so the unique constraint actually holds
  /// (Postgres treats NULLs as distinct).
  scopeRef String               @default("*")
  name     String

  /// Minimum profit over net cost, as a percentage. The price floor.
  minMarginPercent        Decimal @default(5) @db.Decimal(9, 4)
  /// Discount off face value offered to the customer when margin allows.
  customerDiscountPercent Decimal @default(1) @db.Decimal(9, 4)
  /// How far above face value this scope may be priced before the
  /// denomination is treated as non-viable. Gaming tolerates a lot; retail
  /// brands tolerate almost none.
  maxOverFacePercent      Decimal @default(3) @db.Decimal(9, 4)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products GiftCardProduct[]

  @@unique([scope, scopeRef])
  @@map("gift_card_pricing_rules")
}

/// The delivered asset for a GIFT_CARD order — Reloadly's counterpart to
/// ProviderOrder. Card codes are bearer instruments (anyone holding them can
/// spend them), so they are stored only as an AES-256-GCM ciphertext blob and
/// never returned by list endpoints.
model GiftCardIssuance {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid

  provider              ProviderName           @default(RELOADLY)
  /// Reloadly's transactionId, once the order is accepted.
  reloadlyTransactionId BigInt?
  /// Our orderId, sent as Reloadly's `customIdentifier`. Makes the provider
  /// call idempotent: a duplicate is proof the order already went through.
  customIdentifier      String                 @unique
  providerStatus        GiftCardIssuanceStatus @default(PENDING)

  productExternalId Int?
  quantity          Int     @default(1)
  /// Face value sent as Reloadly's `unitPrice`.
  unitPrice         Decimal @db.Decimal(18, 4)

  /// Realized economics, read back from the provider transaction rather than
  /// the synced catalog — prices drift between nightly syncs, so margin is
  /// only trustworthy after the fact.
  amountCharged    Decimal? @db.Decimal(18, 4)
  discountReceived Decimal? @db.Decimal(18, 4)
  feePaid          Decimal? @db.Decimal(18, 4)
  /// retail charged - (amountCharged + feePaid - discountReceived).
  realizedMargin   Decimal? @db.Decimal(18, 4)
  senderCurrency   String?

  /// AES-256-GCM ciphertext of [{ cardNumber, pinCode, redemptionUrl }, ...].
  /// The redemption URL embeds the code, so it is encrypted alongside them.
  cardsEncrypted String?
  cardCount      Int       @default(0)
  codesFetchedAt DateTime?
  revealedAt     DateTime?
  revealCount    Int       @default(0)

  /// Provider payload with card/PIN fields stripped before persisting.
  rawResponse Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([reloadlyTransactionId])
  @@index([providerStatus])
  @@map("gift_card_issuances")
}

/// Audit trail for catalog syncs. The eSIM sync has no equivalent, which
/// makes a half-failed run invisible; with ~13k products and an archive
/// sweep, knowing exactly what a run touched matters.
model GiftCardSyncRun {
  id      String             @id @default(uuid()) @db.Uuid
  status  GiftCardSyncStatus @default(RUNNING)
  /// "cron" | "admin"
  trigger String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  countriesSynced     Int @default(0)
  categoriesSynced    Int @default(0)
  brandsSynced        Int @default(0)
  pagesFetched        Int @default(0)
  productsSynced      Int @default(0)
  productsCreated     Int @default(0)
  productsUpdated     Int @default(0)
  productsArchived    Int @default(0)
  denominationsSynced Int @default(0)
  denominationsHidden Int @default(0)

  /// Populated when the stale sweep declined to run (page errors, or the
  /// archive count breaching GIFTCARD_ARCHIVE_SWEEP_MAX_PERCENT).
  sweepSkippedReason String?
  errors             Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([startedAt])
  @@map("gift_card_sync_runs")
}

/// SMSPool country — separate from eSIM Region and GiftCardCountry.
model SmsCountry {
  id         String   @id @default(uuid()) @db.Uuid
  externalId Int      @unique
  /// ISO short name from SMSPool, e.g. US
  code       String   @unique
  name       String
  region     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  oneTimeOffers SmsOneTimeOffer[]
  rentalSkus    SmsRentalSku[]

  @@index([name])
  @@map("sms_countries")
}

/// SMSPool verification service (WhatsApp, Telegram, …).
model SmsService {
  id         String   @id @default(uuid()) @db.Uuid
  externalId Int      @unique
  name       String
  slug       String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  oneTimeOffers SmsOneTimeOffer[]

  @@index([name])
  @@map("sms_services")
}

/// Buyable one-time SMS SKU: service × country × optional pool.
model SmsOneTimeOffer {
  id          String        @id @default(uuid()) @db.Uuid
  serviceId   String        @db.Uuid
  countryId   String        @db.Uuid
  /// SMSPool pool id; 0 = unspecified / cheapest.
  pool        Int           @default(0)
  providerCost Decimal      @db.Decimal(18, 4)
  retailPrice  Decimal      @db.Decimal(18, 4)
  currency     String       @default("USD")
  successRate  Decimal?     @db.Decimal(9, 4)
  status       ProductStatus @default(DRAFT)
  manualOverride Boolean    @default(false)
  pricingRuleId String?     @db.Uuid
  lastSeenAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  service     SmsService      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  country     SmsCountry      @relation(fields: [countryId], references: [id], onDelete: Cascade)
  pricingRule SmsPricingRule? @relation(fields: [pricingRuleId], references: [id])
  orders      Order[]
  verifications SmsVerification[]

  @@unique([serviceId, countryId, pool])
  @@index([status, countryId])
  @@index([status, serviceId])
  @@index([lastSeenAt])
  @@map("sms_one_time_offers")
}

/// Multi-day rental product from `/rental/retrieve_all` (country/pool row).
model SmsRentalSku {
  id          String   @id @default(uuid()) @db.Uuid
  externalId  Int      @unique
  name        String
  slug        String   @unique
  tag         String?
  region      String?
  countryId   String?  @db.Uuid
  countryCode String?
  pool        Int?
  /// Whether SMSPool reports this rental as extendable (type=1 catalog).
  extendable  Boolean  @default(false)
  priority    Int      @default(0)
  status      ProductStatus @default(DRAFT)
  pricingRuleId String? @db.Uuid
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country     SmsCountry?     @relation(fields: [countryId], references: [id])
  pricingRule SmsPricingRule? @relation(fields: [pricingRuleId], references: [id])
  plans       SmsRentalPlan[]

  @@index([status, countryCode])
  @@index([lastSeenAt])
  @@map("sms_rental_skus")
}

/// Days-tier price for a rental SKU.
model SmsRentalPlan {
  id           String        @id @default(uuid()) @db.Uuid
  rentalSkuId  String        @db.Uuid
  days         Int
  providerCost Decimal       @db.Decimal(18, 4)
  retailPrice  Decimal       @db.Decimal(18, 4)
  currency     String        @default("USD")
  /// Optional stock snapshot from last sync / detail fetch.
  stockCount   Int?
  status       ProductStatus @default(DRAFT)
  manualOverride Boolean     @default(false)
  lastSeenAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  rentalSku SmsRentalSku @relation(fields: [rentalSkuId], references: [id], onDelete: Cascade)
  orders    Order[]
  rentals   NumberRental[]

  @@unique([rentalSkuId, days])
  @@index([status, rentalSkuId])
  @@map("sms_rental_plans")
}

/// Percent markup + optional floor on SMSPool USD cost.
model SmsPricingRule {
  id            String         @id @default(uuid()) @db.Uuid
  scope         SmsPricingScope
  /// Country code, service uuid, rental sku uuid, or "*" for GLOBAL.
  scopeRef      String         @default("*")
  name          String
  markupPercent Decimal        @default(20) @db.Decimal(9, 4)
  /// Minimum retail in USD; null = no floor beyond cost×markup.
  floorAmount   Decimal?       @db.Decimal(18, 4)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  oneTimeOffers SmsOneTimeOffer[]
  rentalSkus    SmsRentalSku[]

  @@unique([scope, scopeRef])
  @@map("sms_pricing_rules")
}

/// Delivered one-time SMS verification asset.
model SmsVerification {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  offerId String @db.Uuid

  provider         ProviderName          @default(SMSPOOL)
  /// SMSPool `order_id` / `order_code`.
  providerOrderId  String?               @unique
  phoneNumber      String?
  countryCode      String?
  /// Short code extracted from SMS when available.
  smsCode          String?
  fullSms          String?
  status           SmsVerificationStatus @default(PENDING)
  providerCost     Decimal?              @db.Decimal(18, 4)
  expiresAt        DateTime?
  rawResponse      Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  offer SmsOneTimeOffer @relation(fields: [offerId], references: [id])

  @@index([status, expiresAt])
  @@index([providerOrderId])
  @@map("sms_verifications")
}

/// Delivered multi-day rented number.
model NumberRental {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  planId  String @db.Uuid

  provider           ProviderName       @default(SMSPOOL)
  rentalCode         String?            @unique
  phoneNumber        String?
  days               Int
  /// Optional SMSPool service the rental was bound to at purchase.
  serviceExternalId  Int?
  serviceName        String?
  status             NumberRentalStatus @default(PENDING)
  autoExtend         Boolean            @default(false)
  expiresAt          DateTime?
  providerCost       Decimal?           @db.Decimal(18, 4)
  rawResponse        Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  order    Order               @relation("RentalPurchase", fields: [orderId], references: [id], onDelete: Cascade)
  plan     SmsRentalPlan       @relation(fields: [planId], references: [id])
  messages NumberRentalMessage[]
  extends  Order[]             @relation("RentalExtends")

  @@index([status, expiresAt])
  @@index([rentalCode])
  @@map("number_rentals")
}

model NumberRentalMessage {
  id                String   @id @default(uuid()) @db.Uuid
  numberRentalId    String   @db.Uuid
  providerMessageId String?
  sender            String?
  fullSms           String
  smsCode           String?
  receivedAt        DateTime @default(now())
  createdAt         DateTime @default(now())

  numberRental NumberRental @relation(fields: [numberRentalId], references: [id], onDelete: Cascade)

  @@unique([numberRentalId, providerMessageId])
  @@index([numberRentalId, receivedAt])
  @@map("number_rental_messages")
}

model SmsSyncRun {
  id      String        @id @default(uuid()) @db.Uuid
  status  SmsSyncStatus @default(RUNNING)
  /// "cron" | "admin"
  trigger String

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  countriesSynced   Int @default(0)
  servicesSynced    Int @default(0)
  offersSynced      Int @default(0)
  offersCreated     Int @default(0)
  offersUpdated     Int @default(0)
  offersArchived    Int @default(0)
  rentalSkusSynced  Int @default(0)
  rentalPlansSynced Int @default(0)
  rentalPlansArchived Int @default(0)

  sweepSkippedReason String?
  errors             Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([startedAt])
  @@map("sms_sync_runs")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}
